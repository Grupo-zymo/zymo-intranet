NODE_ENV=development
PORT=3005
DATABASE_URL=postgresql://zymoally:your-secure-db-password@zymoally-db:5432/zymoallydb
JWT_SECRET=change-me-same-as-fastapi
INTRANET_API_URL=http://backend:8001
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:81

# Central de tickets (casos que radican los clientes en la app de autogestión).
# URL base de la app, sin barra final, y la clave de servicio que ella exige en
# X-Service-Key. Si falta alguna, la central responde "no está configurada".
AUTOGESTION_API_URL=https://pruebas.zymointranet.com
AUTOGESTION_SERVICE_KEY=

# Mesa de ayuda (zymoally-backend): notificaciones push del teléfono (Web Push).
# Generar el par UNA vez con `npx web-push generate-vapid-keys`; la privada es un secreto.
# Si se cambian, todos los dispositivos tienen que volver a activar las notificaciones.
# Sin ellas el push queda apagado y la campana sigue funcionando.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@zymointranet.com
