# Variables que lee docker-compose.yml desde el archivo .env de esta carpeta.
# (Las claves de cada servicio viven en su propio .env; ver <servicio>/.env.example.)

# Central de tickets (zymoally-backend): API de la app de autogestión del cliente.
# URL base sin barra final y la clave de servicio (X-Service-Key). Sin ellas la
# Central de tickets muestra "no está configurada" y no llama a ningún lado.
AUTOGESTION_API_URL=https://pruebas.zymointranet.com
AUTOGESTION_SERVICE_KEY=
